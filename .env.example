# ===== FlareCrawl gateway =====
PORT=4000
PUBLIC_BASE_URL=https://crawl.flare-labs.tech

# ===== Steel fleet =====
# setup.sh fills these from the wizard (how many browsers + port range).
FLEET_SIZE=25
FLEET_PORT_START=3300
FLEET_PORT_END=3324
STEEL_HOST=localhost
STEEL_IMAGE=ghcr.io/steel-dev/steel-browser-api:latest
STEEL_MEM_CAP=2g
STEEL_CPU_CAP=2

# ===== Postgres =====
DATABASE_URL=postgres://crawl:crawl_pw@localhost:5459/crawl

# ===== Admin =====
ADMIN_EMAIL=admin@flare-labs.tech
# setup.sh writes ADMIN_PASSWORD_HASH (scrypt). Never store the plain password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ===== Agent brain (Flare LLM, OpenAI-compatible) =====
LLM_BASE_URL=https://api.flare-sh.tech/v1
LLM_API_KEY=
# Text model for the default DOM loop:
LLM_TEXT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Vision model for the optional screenshot fallback (hybrid). Empty = DOM only.
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AGENT_MAX_STEPS=10
