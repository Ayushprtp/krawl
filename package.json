{
  "name": "flarecrawl-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlareCrawl — self-hosted browser-agent control plane (Steel fleet + AI agents + public live view) for crawl.flare-labs.tech",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:init": "tsx src/db/init.ts",
    "fleet": "bash scripts/fleet.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.2.1",
    "http-proxy": "^1.18.1",
    "pg": "^8.13.1",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
